# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.74
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Base de données — laissez vide en local pour SQLite.
# Render fournit automatiquement cette valeur via render.yaml.
DATABASE_URL=

# APIs
OPENWEATHERMAP_API_KEY=

# Boutique
STORE_NAME=Just Like That
SITE_DESCRIPTION=Just Like That : une sélection de produits utiles, élégants et simples à commander.
SUPPORT_EMAIL=
STORE_CURRENCY_SYMBOL=€
# Exemple : 10 rue Exemple, 75000 Paris, France
STORE_ADDRESS=
# Activez Maps Embed API dans Google Cloud et restreignez la clé à votre domaine.
GOOGLE_MAPS_EMBED_API_KEY=

# Stripe — commencez avec vos clés de test
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur
STRIPE_SHIPPING_COUNTRIES=FR,BE,CA,US,GB,DE,ES,IT,ML,SN,CI

# Cloudflare R2 pour les fichiers MEDIA (pas les statiques)
USE_CLOUDFLARE_R2=False
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Recommandé en production, ex. media.example.com (sans https://)
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Newsletter
NEWSLETTER_PROMO_CODE=JLT8

# E-mail transactionnel / reçus (Gmail SMTP)
# Avec Gmail : activez la validation en 2 étapes puis créez un mot de passe d'application.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SEND_ORDER_RECEIPTS=True
